# Caddy in front of Nawlogic Invoice (used by docker-compose.yml).
# Caddy gets and renews the Let's Encrypt certificate for {$DOMAIN} by itself;
# ports 80 and 443 must be open and the domain's A record must point here.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	# Caddy sets X-Forwarded-For to the real client address (incoming values
	# are not trusted), which the app reads with TRUST_PROXY=1.
	reverse_proxy app:3000
	header -Server
	log {
		output stdout
		format console
	}
}

# Optional: send www to the main name. Add a www A record first.
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
