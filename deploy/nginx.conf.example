# nginx in front of Nawlogic Invoice (the systemd alternative to Docker + Caddy).
# Replace billing.example.com with your domain, get a certificate with certbot
# (sudo certbot --nginx -d billing.example.com), then reload nginx.
# Set TRUST_PROXY=1 in the app's .env: this proxy overwrites X-Forwarded-For
# with the real client address, so clients cannot spoof it.

server {
    listen 80;
    listen [::]:80;
    server_name billing.example.com;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name billing.example.com;

    ssl_certificate /etc/letsencrypt/live/billing.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/billing.example.com/privkey.pem;

    client_max_body_size 10m;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # The AI assistant may take up to two minutes.
        proxy_read_timeout 130s;
    }
}
