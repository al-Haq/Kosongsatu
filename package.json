{
  "name": "nawlogic-invoice",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Nawlogic invoicing workspace - owner billing and secure client documents",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/app.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/app.mjs",
    "setup": "node --env-file-if-exists=.env server/cli.mjs setup",
    "demo": "node server/cli.mjs demo",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "backup": "node --env-file-if-exists=.env server/cli.mjs backup",
    "restore": "node --env-file-if-exists=.env server/cli.mjs restore",
    "recover": "node --env-file-if-exists=.env server/cli.mjs recover",
    "mcp": "node --env-file-if-exists=.env server/mcp.mjs",
    "audit-verify": "node --env-file-if-exists=.env server/cli.mjs audit-verify",
    "audit-head": "node --env-file-if-exists=.env server/cli.mjs audit-head"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "fontkit": "2.0.4",
    "nodemailer": "10.2.1",
    "pdfkit": "0.20.2",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.56.1"
  }
}
