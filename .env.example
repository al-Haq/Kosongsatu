HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/nawlogic.sqlite
NODE_ENV=development
# For production use NODE_ENV=production, HTTPS APP_URL and a TLS reverse proxy.
# The setup command prompts for owner email and a password, or generates one.

# Optional encrypted daily backups; also copy encrypted files off-host.
# Generate each base64 key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# BACKUP_DIRECTORY=/private/backups/nawlogic
# BACKUP_KEY=your-independent-32-byte-base64-key
# Optional stable MFA key. Otherwise a private DATABASE_PATH.mfa-key file is generated.
# MFA_ENCRYPTION_KEY=another-independent-32-byte-base64-key

# Optional built-in assistant: compatible chat/completions provider with function tools.
# Remote URLs require HTTPS; loopback HTTP is allowed for a local model.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=your-installed-tool-capable-model
# AI_API_KEY=private-provider-key-if-required
# Optional outgoing email (invoices, statements and payment reminders).
# Port 587 requires STARTTLS; port 465 uses implicit TLS.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=billing@your-domain.example
# SMTP_PASS=app-specific-password
# MAIL_FROM="Nawlogic Billing <billing@your-domain.example>"
# MAIL_REPLY_TO=accounts@your-domain.example

# Online payments through Billplz (FPX, card, DuitNow). Leave unset to hide "Pay online".
# Set the X Signature key in Billplz > Settings > Keys & Integration and turn X Signature on.
# BILLPLZ_API_KEY=your-secret-key
# BILLPLZ_COLLECTION_ID=your-collection-id
# BILLPLZ_X_SIGNATURE_KEY=your-x-signature-key
# BILLPLZ_SANDBOX=true
# MCP process only: create the scoped token in AI & automation.
# NAWLOGIC_URL=http://127.0.0.1:3000
# NAWLOGIC_CONNECTOR_TOKEN=private-token-shown-once
